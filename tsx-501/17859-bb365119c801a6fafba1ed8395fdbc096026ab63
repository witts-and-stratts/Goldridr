d<string, unknown> ).chauffeur as Record<string, unknown> | undefined : undefined; return { id: number( record.legacyId ), title: String( record.title ), date: String( record.startDate ), endDate: nullable( record.endDate ) || undefined, isFullDay: Number( Boolean( record.isFullDay ) ), time: String( record.startTime || \"\" ), duration: number( record.duration ), recurring: String( record.recurring ), chauffeurId: chauffeurRecord ? String( chauffeurRecord.legacyId ) : null, createdAt: date( record.sourceCreatedAt || record.created ) }; }\nasync function chauffeurRelation( id?: string | null ) { if ( !id ) return \"\"; return ( await first( pocketBaseCollections.chauffeurs, \"legacyId = {:id}\", { id } ) )?.id || \"\"; }\nasync function vehicleRelation( id?: number | null ) { if ( !id ) return \"\"; return ( await first( pocketBaseCollections.vehicles, \"legacyId = {:id}\", { id } ) )?.id || \"\"; }\n\nexport async function getAllChauffeurs() { return ( await pb().collection( pocketBaseCollections.chauffeurs ).getFullList( { filter: \"status = 'active'\", sort: \"name\", expand: \"vehicle\" } ) ).map( chauffeur ); }\nexport async function getChauffeurById( id: string ) { const row = await first( pocketBaseCollections.chauffeurs, \"legacyId = {:id} && status = 'active'\", { id } ); return row ? chauffeur( row ) : undefined; }\nexport async function getChauffeurByEmail( email: string ) { const row = await first( pocketBaseCollections.chauffeurs, \"email = {:email} && status = 'active'\", { email: email.trim().toLowerCase() } ); return row ? chauffeur( row ) : undefined; }\nexport async function getAllVehicles() { return ( await pb().collection( pocketBaseCollections.vehicles ).getFullList( { sort: \"make,model\" } ) ).map( vehicle ); }\nexport async function getVehicleById( id: number ) { const row = await first( pocketBaseCollections.vehicles, \"legacyId = {:id}\", { id } ); return row ? vehicle( row ) : undefined; }\nexport async function getAllBookings() { return (