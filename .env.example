# Authentication
AUTH_SECRET=replace-with-a-long-random-secret
PAYMENT_SETTINGS_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
EMAIL_TRACKING_SECRET=
ADMIN_NAME=General Dispatcher
ADMIN_EMAIL=admin@goldridr.com
ADMIN_PASSWORD=replace-with-a-strong-password
CHAUFFEUR_DEFAULT_PASSWORD=replace-existing-chauffeur-password

# PocketBase is the application's sole data store. The superuser credentials are server-only.
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_PORT=8090
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=

# Notification delivery
EMAIL_TRANSPORT=mailpit
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025
MAILPIT_SECURE=false
NEXT_PUBLIC_MAILPIT_UI_URL=http://localhost:8025

# Generic SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Amazon SES API (static credentials are optional when the AWS credential chain provides a role)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=

# Amazon SES SMTP
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_SECURE=false
SES_SMTP_USER=
SES_SMTP_PASSWORD=

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Inbound email. `auto` uses Mailpit's local API when EMAIL_TRANSPORT=mailpit,
# Resend Receiving when EMAIL_TRANSPORT=resend, otherwise it polls webmail over IMAP.
EMAIL_INBOUND_TRANSPORT=auto
EMAIL_INBOUND_POLL_MS=60000
EMAIL_INBOUND_SCAN_LIMIT=50
MAILPIT_API_URL=http://127.0.0.1:8025
# Only messages sent to this address are treated as inbound replies in Mailpit.
MAILPIT_INBOUND_TO=support@example.com
WEBMAIL_IMAP_HOST=mail.privateemail.com
WEBMAIL_IMAP_PORT=993
WEBMAIL_IMAP_USER=
WEBMAIL_IMAP_PASSWORD=
WEBMAIL_IMAP_MAILBOX=INBOX

# Twilio
TWILIO_TRANSPORT=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public URL Twilio posts inbound SMS to; required for signature validation behind a proxy.
# Set this in the Messaging Service "A message comes in" webhook: <app-url>/api/webhooks/twilio
TWILIO_WEBHOOK_URL=
# Leave false while Twilio Advanced Opt-Out is enabled, otherwise STOP/HELP get two replies.
TWILIO_INBOUND_AUTO_REPLY=false
# Public business number shown on the contact page. Leave blank to omit phone contact.
NEXT_PUBLIC_CONTACT_PHONE=

# Booking quotes and payment checkout
APP_URL=http://localhost:3000
GOOGLE_MAPS_API_KEY=
ACTIVE_PAYMENT_PROCESSOR=stripe
ENABLED_PAYMENT_PROCESSORS=stripe,square,paypal,zelle
ENABLED_PAYMENT_METHODS=card,apple_pay,cash_app,venmo,zelle
PAYMENT_HOLD_MINUTES=120
ZELLE_VERIFICATION_HOURS=24
HOURLY_RATE=75
ZELLE_RECIPIENT=
ZELLE_INSTRUCTIONS=Send the exact fare and include your booking reference in the memo.

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Square
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APP_ID=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=http://localhost:3000/api/webhooks/square

# PayPal / Venmo
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Application and worker
NOTIFICATION_POLL_MS=500
FLIGHT_TRACKING_POLL_MS=30000

# Admin PWA Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:email@example.com

FLIGHT_PRIMARY_PROVIDER=aviationstack
FLIGHT_AVIATIONSTACK_ENABLED=false
FLIGHT_MANUAL_MAX_PER_HOUR=20
AVIATIONSTACK_API_KEY=
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_CONCURRENCY=5
