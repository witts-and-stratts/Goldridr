# Authentication
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_NAME=General Dispatcher
ADMIN_EMAIL=admin@goldridr.com
ADMIN_PASSWORD=replace-with-a-strong-password
CHAUFFEUR_DEFAULT_PASSWORD=replace-existing-chauffeur-password

# Database
# Leave both empty for local development with file:bookings.db.
# Set both in production to use Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# PocketBase staged migration
# The superuser token is server-only and must never use a NEXT_PUBLIC_ prefix.
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_PORT=8090
POCKETBASE_SUPERUSER_TOKEN=
POCKETBASE_AUTH=false
POCKETBASE_CORE_WRITE=false
POCKETBASE_NOTIFICATIONS_READ=false
POCKETBASE_NOTIFICATIONS_WRITE=false
POCKETBASE_DELIVERY_QUEUE=false

# Notification delivery
EMAIL_TRANSPORT=mailpit
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025
MAILPIT_SECURE=false
NEXT_PUBLIC_MAILPIT_UI_URL=http://localhost:8025

# Generic SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Amazon SES API (static credentials are optional when the AWS credential chain provides a role)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=

# Amazon SES SMTP
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_SECURE=false
SES_SMTP_USER=
SES_SMTP_PASSWORD=

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Twilio
TWILIO_TRANSPORT=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Application and worker
NOTIFICATION_POLL_MS=5000
