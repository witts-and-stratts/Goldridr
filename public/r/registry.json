      "files": [
        {
          "path": "src/components/ui/super-field.tsx",
          "type": "registry:ui",
          "target": "@ui/super-field.tsx"
        },
        {
          "path": "src/components/ui/quill-editor.tsx",
          "type": "registry:ui",
